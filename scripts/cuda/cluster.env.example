# 站点相关的多节点参数模板。复制为 scripts/cuda/cluster.env 后填入真实值：
#
#   cp scripts/cuda/cluster.env.example scripts/cuda/cluster.env
#
# cluster.env 已被 .gitignore 排除：节点地址属于内部拓扑，不入公开仓库。
# env_roce.sh 会在存在时自动载入它。

# rank 0 所在节点的地址，三个节点都要能连上它。
MASTER_ADDR=

# rendezvous 端口；确认 Pod 之间该端口互通。
MASTER_PORT=29500

# 节点数与每节点卡数。
NNODES=3
NPROC_PER_NODE=8
